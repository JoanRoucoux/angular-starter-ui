{
  "schema": 1,
  "starter": "angular-starter-ui",
  "nameSuffix": "-ui",
  "prompts": [],
  "copyIgnore": [
    ".git",
    "node_modules",
    "dist",
    "coverage",
    ".angular",
    "storybook-static",
    ".claude/settings.local.json",
    "pnpm-debug.log"
  ],
  "remove": [
    "CHANGELOG.md",
    ".github/CODE_OF_CONDUCT.md",
    ".github/CONTRIBUTING.md",
    ".github/SECURITY.md",
    "LICENSE",
    ".github/assets",
    ".github/ISSUE_TEMPLATE",
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/workflows/release-please.yml",
    ".github/workflows/dependabot-auto-merge.yml",
    ".github/workflows/generator-check.yml"
  ],
  "jsonPatch": [
    {
      "file": "package.json",
      "set": {
        "name": "{{projectName}}",
        "version": "0.1.0",
        "description": "{{title}}: an Angular design system."
      },
      "delete": ["keywords", "homepage", "bugs", "repository", "license", "author"]
    },
    {
      "file": "projects/ui/package.json",
      "set": {
        "name": "{{projectName}}",
        "version": "0.1.0"
      }
    }
  ],
  "replace": [
    {
      "file": "AGENTS.md",
      "search": "\nStarter maintenance notes (generator manifest, templates, starter-only workflows) live in [.generator/README.md](.generator/README.md).\n",
      "value": ""
    }
  ],
  "replaceAll": [
    {
      "extensions": [".ts", ".json", ".mdx", ".md"],
      "search": "'angular-starter-ui/",
      "value": "'{{projectName}}/"
    },
    {
      "extensions": [".ts", ".json", ".mdx", ".md"],
      "search": "\"angular-starter-ui/",
      "value": "\"{{projectName}}/"
    },
    {
      "extensions": [".mdx", ".md"],
      "search": "node_modules/angular-starter-ui",
      "value": "node_modules/{{projectName}}"
    },
    {
      "extensions": [".mdx", ".md"],
      "search": "pnpm add angular-starter-ui",
      "value": "pnpm add {{projectName}}"
    }
  ],
  "install": "pnpm install",
  "postInstall": ["pnpm run format"],
  "nextSteps": ["pnpm start"]
}
